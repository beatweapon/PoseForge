from __future__ import annotations

import argparse
import sys
from pathlib import Path

from .blender_runner import run_blender_render
from .config import load_config
from .render import SUPPORTED_CAMERAS
from .scene import build_simple_humanoid_rig
from .validation import validate_render_outputs


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="PoseForge CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    render_parser = subparsers.add_parser("render", help="render a pose using Blender")
    render_parser.add_argument("config", type=str, help="path to the JSON config file")
    render_parser.add_argument("--blender-exe", default=None, help="explicit path to the Blender executable")
    render_parser.add_argument("--dry-run", action="store_true", help="validate config and plan renders without invoking Blender")

    return parser


def _dry_run_report(config: dict[str, object], output_dir: Path) -> int:
    expected_views = list(config["cameras"])  # type: ignore[arg-type]
    file_names = [f"{camera}.png" for camera in expected_views]
    output_dir.mkdir(parents=True, exist_ok=True)
    report = {
        "mode": "dry-run",
        "camera_views": expected_views,
        "expected_files": file_names,
        "output_dir": str(output_dir),
        "status": "planned",
    }
    (output_dir / "render_report.json").write_text(__import__("json").dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("Dry-run mode: planned render files:")
    for name in file_names:
        print(f"  - {output_dir / name}")
    return 0


def render_command(config_path: str, blender_exe: str | None, dry_run: bool = False) -> int:
    config = load_config(config_path)
    output_dir = Path(config["output"])
    output_dir.mkdir(parents=True, exist_ok=True)

    if dry_run:
        return _dry_run_report(config, output_dir)

    exit_code = run_blender_render(config_path, blender_exe)
    if exit_code != 0:
        return exit_code

    output_files = sorted(str(path) for path in output_dir.glob("*.png"))
    if not output_files:
        print(f"No PNG files were generated in {output_dir}", file=sys.stderr)
        return 1

    report = validate_render_outputs(output_files, config["cameras"])
    print("Render validation:", report)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "render":
        return render_command(args.config, args.blender_exe, args.dry_run)

    parser.error(f"Unsupported command: {args.command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
