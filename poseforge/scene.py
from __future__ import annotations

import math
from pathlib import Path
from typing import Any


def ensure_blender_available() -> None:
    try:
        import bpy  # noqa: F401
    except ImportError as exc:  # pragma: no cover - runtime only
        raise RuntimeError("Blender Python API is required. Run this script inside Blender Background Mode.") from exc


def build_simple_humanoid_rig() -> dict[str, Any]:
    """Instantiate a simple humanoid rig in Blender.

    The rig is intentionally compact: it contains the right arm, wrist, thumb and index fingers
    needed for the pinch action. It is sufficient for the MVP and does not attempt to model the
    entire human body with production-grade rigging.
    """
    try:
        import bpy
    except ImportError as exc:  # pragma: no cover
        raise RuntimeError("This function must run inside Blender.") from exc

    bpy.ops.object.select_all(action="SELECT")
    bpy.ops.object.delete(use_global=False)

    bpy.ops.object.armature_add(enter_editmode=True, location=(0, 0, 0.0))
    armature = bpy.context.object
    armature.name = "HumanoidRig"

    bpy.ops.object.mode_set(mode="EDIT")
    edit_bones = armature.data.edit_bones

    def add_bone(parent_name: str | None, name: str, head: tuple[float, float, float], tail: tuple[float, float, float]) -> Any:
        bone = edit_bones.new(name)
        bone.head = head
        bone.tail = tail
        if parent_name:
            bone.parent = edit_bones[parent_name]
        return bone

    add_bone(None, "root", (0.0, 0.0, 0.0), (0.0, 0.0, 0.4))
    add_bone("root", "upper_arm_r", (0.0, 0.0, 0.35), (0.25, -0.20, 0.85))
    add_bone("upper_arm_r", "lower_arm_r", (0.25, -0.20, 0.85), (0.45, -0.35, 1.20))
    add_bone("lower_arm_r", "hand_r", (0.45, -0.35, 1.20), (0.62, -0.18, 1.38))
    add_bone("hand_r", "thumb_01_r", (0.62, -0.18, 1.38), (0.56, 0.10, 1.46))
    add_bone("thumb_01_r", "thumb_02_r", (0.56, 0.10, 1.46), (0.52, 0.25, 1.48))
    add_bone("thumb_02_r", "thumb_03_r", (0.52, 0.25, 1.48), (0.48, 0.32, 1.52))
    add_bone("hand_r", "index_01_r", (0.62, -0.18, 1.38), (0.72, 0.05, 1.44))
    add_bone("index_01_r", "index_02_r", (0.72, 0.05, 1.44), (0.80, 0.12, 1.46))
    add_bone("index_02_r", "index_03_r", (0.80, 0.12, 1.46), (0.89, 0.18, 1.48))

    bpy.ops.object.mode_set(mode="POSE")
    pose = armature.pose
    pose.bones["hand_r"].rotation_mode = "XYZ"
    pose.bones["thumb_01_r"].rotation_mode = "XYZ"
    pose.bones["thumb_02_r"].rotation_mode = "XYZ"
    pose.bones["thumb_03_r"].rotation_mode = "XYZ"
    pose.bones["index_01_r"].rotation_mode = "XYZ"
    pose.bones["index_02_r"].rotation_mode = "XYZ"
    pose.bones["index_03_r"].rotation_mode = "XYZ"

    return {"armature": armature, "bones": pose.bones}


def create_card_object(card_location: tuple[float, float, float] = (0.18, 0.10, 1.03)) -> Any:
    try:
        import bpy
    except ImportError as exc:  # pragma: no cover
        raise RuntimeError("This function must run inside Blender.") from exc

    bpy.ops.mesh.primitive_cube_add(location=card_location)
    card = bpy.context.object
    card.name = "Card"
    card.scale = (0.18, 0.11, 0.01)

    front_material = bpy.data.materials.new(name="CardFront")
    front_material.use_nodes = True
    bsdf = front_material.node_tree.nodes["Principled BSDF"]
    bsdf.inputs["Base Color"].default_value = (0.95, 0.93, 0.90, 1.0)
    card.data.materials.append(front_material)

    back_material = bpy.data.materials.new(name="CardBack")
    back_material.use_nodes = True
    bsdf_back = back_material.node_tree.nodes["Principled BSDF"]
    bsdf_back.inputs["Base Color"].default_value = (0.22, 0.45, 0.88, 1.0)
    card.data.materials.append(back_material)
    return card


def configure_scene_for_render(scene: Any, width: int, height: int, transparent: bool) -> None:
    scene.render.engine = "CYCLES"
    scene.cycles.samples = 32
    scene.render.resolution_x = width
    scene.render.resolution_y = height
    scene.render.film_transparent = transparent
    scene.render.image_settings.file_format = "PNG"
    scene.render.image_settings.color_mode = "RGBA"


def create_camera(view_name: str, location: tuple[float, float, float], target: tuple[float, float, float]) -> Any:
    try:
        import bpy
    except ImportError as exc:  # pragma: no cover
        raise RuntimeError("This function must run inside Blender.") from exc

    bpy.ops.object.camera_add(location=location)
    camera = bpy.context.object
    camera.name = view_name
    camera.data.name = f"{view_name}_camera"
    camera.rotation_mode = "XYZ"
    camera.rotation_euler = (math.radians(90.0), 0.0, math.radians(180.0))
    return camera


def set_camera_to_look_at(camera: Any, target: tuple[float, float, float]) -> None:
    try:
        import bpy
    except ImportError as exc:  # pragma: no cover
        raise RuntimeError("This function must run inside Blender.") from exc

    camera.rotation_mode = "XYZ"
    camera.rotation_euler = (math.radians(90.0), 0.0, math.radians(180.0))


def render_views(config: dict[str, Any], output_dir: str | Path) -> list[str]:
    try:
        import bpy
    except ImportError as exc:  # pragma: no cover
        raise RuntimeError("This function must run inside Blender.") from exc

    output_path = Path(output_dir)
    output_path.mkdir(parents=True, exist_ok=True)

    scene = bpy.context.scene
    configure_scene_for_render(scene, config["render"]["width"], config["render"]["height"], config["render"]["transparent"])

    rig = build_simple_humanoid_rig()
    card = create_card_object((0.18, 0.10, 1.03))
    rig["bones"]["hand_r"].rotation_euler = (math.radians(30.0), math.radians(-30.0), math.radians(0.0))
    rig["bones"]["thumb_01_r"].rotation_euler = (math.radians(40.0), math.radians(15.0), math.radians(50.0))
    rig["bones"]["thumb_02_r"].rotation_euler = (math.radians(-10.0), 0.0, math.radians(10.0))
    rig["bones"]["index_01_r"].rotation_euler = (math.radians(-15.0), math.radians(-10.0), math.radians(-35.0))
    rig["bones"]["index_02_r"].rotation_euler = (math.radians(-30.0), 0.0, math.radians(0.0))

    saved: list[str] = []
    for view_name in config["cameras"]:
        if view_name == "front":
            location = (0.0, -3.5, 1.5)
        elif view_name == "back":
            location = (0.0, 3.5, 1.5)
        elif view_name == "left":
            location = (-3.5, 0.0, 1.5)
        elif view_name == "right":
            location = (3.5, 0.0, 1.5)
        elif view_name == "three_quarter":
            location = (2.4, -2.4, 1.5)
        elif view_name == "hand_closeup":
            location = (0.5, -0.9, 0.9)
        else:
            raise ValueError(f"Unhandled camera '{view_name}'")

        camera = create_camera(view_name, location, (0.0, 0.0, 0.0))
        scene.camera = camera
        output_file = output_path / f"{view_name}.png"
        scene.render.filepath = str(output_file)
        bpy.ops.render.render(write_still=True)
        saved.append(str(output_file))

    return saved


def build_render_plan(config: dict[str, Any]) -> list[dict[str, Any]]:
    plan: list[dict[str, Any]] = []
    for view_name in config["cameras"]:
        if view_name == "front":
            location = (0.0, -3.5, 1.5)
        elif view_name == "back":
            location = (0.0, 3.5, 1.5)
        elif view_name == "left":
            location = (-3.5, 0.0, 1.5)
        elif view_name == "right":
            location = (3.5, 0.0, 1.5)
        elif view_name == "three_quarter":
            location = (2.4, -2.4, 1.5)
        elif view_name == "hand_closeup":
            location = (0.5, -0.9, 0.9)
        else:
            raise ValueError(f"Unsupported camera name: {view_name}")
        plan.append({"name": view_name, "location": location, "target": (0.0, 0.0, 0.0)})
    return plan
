from __future__ import annotations

import json
import sys
from pathlib import Path


def _inject_project_root() -> None:
    repo_root = Path(__file__).resolve().parents[1]
    if str(repo_root) not in sys.path:
        sys.path.insert(0, str(repo_root))


_inject_project_root()

from poseforge.config import load_config  # noqa: E402
from poseforge.scene import render_views  # noqa: E402


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run PoseForge in Blender Background Mode")
    parser.add_argument("--config", required=True, help="path to the JSON config file")
    parser.add_argument("--dry-run", action="store_true", help="validate the config and print planned outputs without Blender")
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    config_path = Path(args.config).resolve()
    if not config_path.exists():
        raise FileNotFoundError(f"Configuration file not found: {config_path}")

    config = load_config(config_path)
    output_dir = Path(config["output"])
    output_dir.mkdir(parents=True, exist_ok=True)

    if args.dry_run:
        payload = {
            "mode": "dry-run",
            "config": config,
            "planned_outputs": [f"{camera}.png" for camera in config["cameras"]],
            "status": "planned",
        }
        report_path = output_dir / "render_report.json"
        with report_path.open("w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        print(json.dumps({"mode": "dry-run", "planned_outputs": payload["planned_outputs"]}, ensure_ascii=False))
        return 0

    render_results = render_views(config, output_dir)
    payload = {
        "config": config,
        "rendered_files": render_results,
        "status": "success",
    }

    report_path = output_dir / "render_report.json"
    with report_path.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, ensure_ascii=False)
        handle.write("\n")

    print(json.dumps({"rendered_files": render_results, "report": str(report_path)}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
